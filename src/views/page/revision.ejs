<%- include('../partials/header') %>

<div class="wiki-header">
  <h1><a href="/w/<%= wiki.slug %>"><%= wiki.name %></a></h1>
</div>

<div class="revision-page">
  <div class="revision-header">
    <h2>Revision of: <%= page.title %></h2>
    <p class="revision-meta">
      Saved on <%= new Date(revision.created_at).toLocaleString() %> 
      by <strong><%= revision.editor || 'Anonymous' %></strong>
      <% if (revision.edit_summary) { %>
        — "<em><%= revision.edit_summary %></em>"
      <% } %>
    </p>
    <div class="revision-actions">
      <a href="/w/<%= wiki.slug %>/<%= page.slug %>" class="btn">View Current</a>
      <a href="/w/<%= wiki.slug %>/<%= page.slug %>/history" class="btn">Back to History</a>
    </div>
  </div>

  <article class="page-content revision-content">
    <div class="page-body markdown-content">
      <%- content %>
    </div>
  </article>
</div>

<%- include('../partials/footer') %>
