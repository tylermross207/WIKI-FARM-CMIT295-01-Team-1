<%- include('../partials/header') %>

<div class="wiki-header">
  <h1><a href="/w/<%= wiki.slug %>"><%= wiki.name %></a></h1>
</div>

<div class="history-page">
  <h2>History: <%= page.title %></h2>
  <a href="/w/<%= wiki.slug %>/<%= page.slug %>" class="btn">← Back to Page</a>

  <% if (revisions.length === 0) { %>
    <p class="empty-state">No revision history for this page.</p>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Editor</th>
          <th>Summary</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% revisions.forEach(revision => { %>
          <tr>
            <td><%= new Date(revision.created_at).toLocaleString() %></td>
            <td><%= revision.editor || 'Anonymous' %></td>
            <td><%= revision.edit_summary || '-' %></td>
            <td>
              <a href="/w/<%= wiki.slug %>/<%= page.slug %>/revision/<%= revision.id %>" class="btn btn-sm">View</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
