<%- include('../partials/header') %>

<div class="create-wiki-container">
  <!-- Preview on the LEFT side -->
  <div class="preview-section">
    <h2>Preview</h2>
    <div class="preview-card">
      <div class="preview-header">
        <h3 id="previewName">Your Wiki Name</h3>
        <div class="preview-meta">
          <span class="preview-slug" id="previewSlug">/w/your-wiki-slug</span>
        </div>
      </div>

      <% if (true) { %>
        <div class="preview-image" id="previewImage" style="display:none;">
          <img id="previewImageElement" src="" alt="Wiki Image" style="max-width: 100%; height: auto; border-radius: 8px; margin-bottom: 1rem;">
        </div>
      <% } %>

      <% if (true) { %>
        <div class="preview-video" id="previewVideo" style="display:none;">
          <div class="youtube-embed-wrapper">
            <iframe 
              id="previewIframe"
              width="100%" 
              height="315" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen>
            </iframe>
          </div>
        </div>
      <% } %>

      <div class="preview-description" id="previewDescription">
        Your wiki description will appear here
      </div>

      <div class="preview-badges">
        <span class="badge" id="publicBadge">🌐 Public</span>
        <span class="badge" id="editBadge" style="display:none;">✏️ Open Edit</span>
      </div>
    </div>
  </div>

  <!-- Form on the RIGHT side -->
  <div class="form-section">
    <h1>Create a New Wiki</h1>
    
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (!user) { %>
      <div class="alert alert-info">
        <strong>Welcome!</strong> Create your account and wiki in one step. No password needed - we'll send you a link to set one later.
      </div>
    <% } %>

    <form method="POST" action="/w/create" class="wiki-form" id="wikiForm" enctype="multipart/form-data">
      <% if (!user) { %>
        <h2 style="font-size: 1.1rem; margin: 1rem 0 1.5rem;">Your Account</h2>
        
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" placeholder="your-username" 
                 pattern="[a-zA-Z0-9_-]+" title="Alphanumeric, underscore, and hyphen only">
          <small>Your unique username (3+ characters)</small>
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" placeholder="your@email.com">
          <small>We'll use this to send you important updates</small>
        </div>

        <hr style="margin: 2rem 0; border: none; border-top: 2px solid var(--border);">
      <% } %>

      <h2 style="font-size: 1.1rem; margin: 1rem 0 1.5rem;">Wiki Details</h2>
      
      <div class="form-group">
        <label for="name">Wiki Name</label>
        <input type="text" id="name" name="name" required autofocus placeholder="My Awesome Wiki">
      </div>

      <div class="form-group">
        <label for="slug">URL Slug</label>
        <div class="input-prefix">
          <span>/w/</span>
          <input type="text" id="slug" name="slug" required 
                 pattern="[a-z0-9-]+" title="Lowercase letters, numbers, and hyphens only"
                 placeholder="my-awesome-wiki">
        </div>
        <small>This will be part of your wiki's URL</small>
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="3" 
                  placeholder="What is this wiki about?"></textarea>
      </div>

      <div class="form-group">
        <label for="youtube_url">YouTube Video URL (Optional)</label>
        <input type="url" id="youtube_url" name="youtube_url" 
               placeholder="https://www.youtube.com/watch?v=..." 
               pattern="https://.*youtube\.com/.*">
        <small>Paste a YouTube link to embed a video on your wiki</small>
      </div>

      <div class="form-group">
        <label for="wiki_image">Wiki Image (Optional)</label>
        <input type="file" id="wiki_image" name="wiki_image" accept="image/*">
        <small>Upload an image to display on your wiki's home page (PNG, JPG, GIF - max 5MB)</small>
      </div>

      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="is_public" checked>
          <span>Public wiki (visible to everyone)</span>
        </label>
      </div>

      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="allow_public_edit">
          <span>Allow anyone to edit (open wiki)</span>
        </label>
      </div>

      <hr style="margin: 2rem 0; border: none; border-top: 2px solid var(--border);">

      <h2 style="font-size: 1.3rem; margin: 1rem 0;">First Page (Required)</h2>
      <p style="color: var(--text-muted); margin-bottom: 1rem;">Every wiki needs a first page. Choose an existing page or create a new one.</p>

      <div class="form-group">
        <label for="pageOption">Page Option</label>
        <select id="pageOption" name="pageOption" required onchange="updatePageFields()">
          <option value="">-- Select an option --</option>
          <option value="new">Create a new page</option>
          <option value="home">Use default home page</option>
        </select>
      </div>

      <!-- New Page Fields - INSIDE the form so they are submitted -->
      <div id="newPageFields">
        <div class="form-group">
          <label for="firstPageTitle">New Page Title</label>
          <input type="text" id="firstPageTitle" name="firstPageTitle" placeholder="e.g., Introduction">
        </div>

        <div class="form-group">
          <label for="firstPageContent">New Page Content</label>
          <textarea id="firstPageContent" name="firstPageContent" rows="8" placeholder="Write your page content here... (Markdown supported)"></textarea>
        </div>
      </div>

      <div class="form-actions">
        <a href="/" class="btn">Cancel</a>
        <button type="submit" class="btn btn-primary">Create Wiki</button>
      </div>
    </form>

    <!-- Page Preview Section - shown beside form when creating new page -->
    <div id="pagePreviewContainer">
      <div id="pagePreviewSection" class="page-preview-card">
        <h2>Page Preview</h2>
        <div class="preview-card">
          <div class="preview-header">
            <h3 id="pagePreviewTitle" style="word-break: break-word;">Your Page Title</h3>
          </div>
          <div class="preview-content" id="pagePreviewContent" style="margin-top: 1rem; padding: 1rem; background: rgba(0,0,0,0.03); border-radius: 8px; min-height: 100px; max-height: 300px; overflow-y: auto;">
            Your page content will appear here
          </div>
        </div>
      </div>
    </div>
  </div>

<script>
  // Helper function to strip HTML tags and dangerous content
  function stripHtmlTags(input) {
    if (!input) return '';
    
    // Remove all HTML tags
    let cleaned = input.replace(/<[^>]*>/g, '');
    
    // Remove common JavaScript patterns
    cleaned = cleaned.replace(/javascript:/gi, '');
    cleaned = cleaned.replace(/on\w+\s*=/gi, '');
    cleaned = cleaned.replace(/eval\(/gi, '');
    cleaned = cleaned.replace(/expression\(/gi, '');
    
    // Remove HTML entities that could be used for attacks
    cleaned = cleaned.replace(/&#?\w+;/g, '');
    
    return cleaned.trim();
  }

  // Get all form inputs
  const nameInput = document.getElementById('name');
  const slugInput = document.getElementById('slug');
  const descriptionInput = document.getElementById('description');
  const youtubeInput = document.getElementById('youtube_url');
  const imageInput = document.getElementById('wiki_image');
  const publicCheckbox = document.querySelector('input[name="is_public"]');
  const editCheckbox = document.querySelector('input[name="allow_public_edit"]');

  // Get all preview elements
  const previewName = document.getElementById('previewName');
  const previewSlug = document.getElementById('previewSlug');
  const previewDescription = document.getElementById('previewDescription');
  const previewImage = document.getElementById('previewImage');
  const previewImageElement = document.getElementById('previewImageElement');
  const previewVideo = document.getElementById('previewVideo');
  const previewIframe = document.getElementById('previewIframe');
  const publicBadge = document.getElementById('publicBadge');
  const editBadge = document.getElementById('editBadge');

  // Function to extract YouTube video ID
  function extractYouTubeId(url) {
    if (!url) return null;
    const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\n?#]+)/);
    return match ? match[1] : null;
  }

  // Function to update preview with filtered content
  function updatePreview() {
    // Filter and update name (remove HTML tags)
    const filteredName = stripHtmlTags(nameInput.value);
    previewName.textContent = filteredName || 'Your Wiki Name';

    // Filter and update slug
    const filteredSlug = stripHtmlTags(slugInput.value);
    previewSlug.textContent = '/w/' + (filteredSlug || 'your-wiki-slug');

    // Filter and update description
    const filteredDescription = stripHtmlTags(descriptionInput.value);
    previewDescription.textContent = filteredDescription || 'Your wiki description will appear here';

    // Update image preview
    if (imageInput.files && imageInput.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        previewImageElement.src = e.target.result;
        previewImage.style.display = 'block';
      };
      reader.readAsDataURL(imageInput.files[0]);
    } else {
      previewImage.style.display = 'none';
    }

    // Update YouTube video
    const videoId = extractYouTubeId(youtubeInput.value);
    if (videoId) {
      previewVideo.style.display = 'block';
      previewIframe.src = `https://www.youtube.com/embed/${videoId}`;
    } else {
      previewVideo.style.display = 'none';
    }

    // Update badges
    publicBadge.style.display = publicCheckbox.checked ? 'inline-block' : 'none';
    editBadge.style.display = editCheckbox.checked ? 'inline-block' : 'none';
  }

  // Add event listeners for live preview
  nameInput.addEventListener('input', updatePreview);
  slugInput.addEventListener('input', updatePreview);
  descriptionInput.addEventListener('input', updatePreview);
  youtubeInput.addEventListener('input', updatePreview);
  publicCheckbox.addEventListener('change', updatePreview);
  editCheckbox.addEventListener('change', updatePreview);

  // Initial preview update
  updatePreview();

  // Page option management
  function updatePageFields() {
    const pageOption = document.getElementById('pageOption').value;
    const formSection = document.querySelector('.form-section');
    const firstPageTitle = document.getElementById('firstPageTitle');
    const firstPageContent = document.getElementById('firstPageContent');

    if (pageOption === 'new') {
      formSection.classList.add('with-preview');
      firstPageTitle.required = true;
      firstPageContent.required = true;
      updatePagePreview();
    } else {
      formSection.classList.remove('with-preview');
      firstPageTitle.required = false;
      firstPageContent.required = false;
    }
  }

  // Update page preview
  function updatePagePreview() {
    const pageTitle = document.getElementById('firstPageTitle').value;
    const pageContent = document.getElementById('firstPageContent').value;
    const pagePreviewTitle = document.getElementById('pagePreviewTitle');
    const pagePreviewContent = document.getElementById('pagePreviewContent');

    pagePreviewTitle.textContent = stripHtmlTags(pageTitle) || 'Your Page Title';
    
    // Simple markdown rendering for preview (bold, italic, headings, lists)
    let renderedContent = stripHtmlTags(pageContent) || 'Your page content will appear here';
    
    // Convert markdown-style formatting for display
    renderedContent = renderedContent
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')  // **bold**
      .replace(/\*(.*?)\*/g, '<em>$1</em>')              // *italic*
      .replace(/^### (.*?)$/gm, '<strong style="font-size: 0.9em; display: block; margin-top: 8px;">$1</strong>')  // ### heading
      .replace(/^## (.*?)$/gm, '<strong style="font-size: 1.1em; display: block; margin-top: 10px;">$1</strong>')   // ## heading
      .replace(/^# (.*?)$/gm, '<strong style="font-size: 1.3em; display: block; margin-top: 12px;">$1</strong>')    // # heading
      .replace(/\n/g, '<br>');  // Line breaks
    
    pagePreviewContent.innerHTML = renderedContent;
  }

  // Add event listeners for page preview
  document.getElementById('firstPageTitle').addEventListener('input', updatePagePreview);
  document.getElementById('firstPageContent').addEventListener('input', updatePagePreview);

  // Initialize page fields visibility on page load
  document.addEventListener('DOMContentLoaded', function() {
    updatePageFields();
  });

  // Form validation
  document.getElementById('wikiForm').addEventListener('submit', function(e) {
    // First check page option
    const pageOption = document.getElementById('pageOption').value;
    if (!pageOption) {
      e.preventDefault();
      alert('Please select a page option (Create new or use default home page)');
      return false;
    }

    // Then check if new page option requires title
    if (pageOption === 'new') {
      const firstPageTitle = document.getElementById('firstPageTitle').value.trim();
      if (!firstPageTitle) {
        e.preventDefault();
        alert('Please enter a title for the new page');
        return false;
      }
    }

    // Check if username field exists (user not logged in)
    const usernameField = document.getElementById('username');
    
    if (usernameField) {
      const username = usernameField.value.trim();
      const email = document.getElementById('email').value.trim();
      
      if (!username) {
        e.preventDefault();
        alert('Please enter a username');
        return false;
      }
      
      if (username.length < 3) {
        e.preventDefault();
        alert('Username must be at least 3 characters');
        return false;
      }
      
      if (!email) {
        e.preventDefault();
        alert('Please enter an email address');
        return false;
      }
      
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        e.preventDefault();
        alert('Please enter a valid email address');
        return false;
      }
    }
  });

</script>

<%- include('../partials/footer') %>
