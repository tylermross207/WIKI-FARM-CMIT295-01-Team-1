<%- include('partials/header') %>

<div class="top-info-text"><a href="/what-is-a-wiki">what is a wiki</a></div>

<div class="home-hero">
  <div class="hero-left">
    <h1>🌱 You Can Wiki Now!</h1>
    <p>Welcome to the WIKI Farm — a place to create, grow, and share knowledge in a friendly, vintage-styled space.</p>

    <div class="search-input" aria-label="Search">
      <input type="search" name="q" placeholder="Search the farm..." />
      <button aria-label="Search">🔍</button>
    </div>

    <% if (!user) { %>
      <div class="hero-actions">
        <a href="/auth/register" class="btn btn-primary btn-lg">Get Started</a>
        <a href="/auth/login" class="btn btn-lg">Login</a>
      </div>
    <% } else { %>
      <div class="hero-actions">
        <a href="/w/create" class="btn btn-primary btn-lg">Create a Wiki</a>
      </div>
    <% } %>
  </div>

  <div class="hero-right">
    <!-- Add a vintage phone or decorative image at public/images/phone.png to match the mock -->
    <img src="/images/phone.png" alt="vintage phone" />
  </div>
</div>

<section class="wiki-list">
  <h2>Public Wikis</h2>
  <% if (wikis.length === 0) { %>
    <p class="empty-state">No public wikis yet. Be the first to create one!</p>
  <% } else { %>
    <div class="wiki-grid">
      <% wikis.forEach(wiki => { %>
        <a href="/w/<%= wiki.slug %>" class="wiki-card">
          <h3><%= wiki.name %></h3>
          <p class="wiki-description"><%= wiki.description || 'No description' %></p>
          <div class="wiki-meta">
            <span>📄 <%= wiki.page_count %> pages</span>
            <span>👤 <%= wiki.owner_name %></span>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>