<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>WIKI-FARM-CMIT295-01-Team-1</title>
  <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="main-header">
    <nav class="container">
      <a href="/" class="logo">WIKI-FARM-CMIT295-01-Team-1</a>
      <div class="nav-links">
        <a href="/" class="nav-item">Home</a>
        <a href="/about" class="nav-item">About</a>
        <a href="/contact" class="nav-item">Contact</a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/w/create" class="btn btn-primary">Create Wiki</a>
          <% if (user.is_admin) { %>
            <a href="/admin">Admin</a>
          <% } %>
        <% } %>
        
        <!-- Theme Selector -->
        <select id="theme-selector" class="theme-selector" onchange="applyTheme(this.value)">
          <option value="burgundy">Burgundy</option>
          <option value="ocean">Ocean</option>
          <option value="forest">Forest</option>
          <option value="sunset">Sunset</option>
          <option value="purple">Purple</option>
          <option value="slate">Slate</option>
        </select>
        <script>
          const savedTheme = localStorage.getItem('wiki-farm-theme') || 'burgundy';
          const selector = document.getElementById('theme-selector');
          if (selector) {
            selector.value = savedTheme;
          }
        </script>
        
        <!-- Dark Mode Toggle -->
        <button id="dark-mode-btn" class="dark-mode-btn" onclick="toggleDarkMode()" title="Toggle Dark Mode">
          🌙
        </button>
        
        <% if (typeof user !== 'undefined' && user) { %>
          <span class="user-info">
            👤 <%= user.username %>
            <a href="/auth/logout" class="btn btn-sm">Logout</a>
          </span>
        <% } else { %>
          <a href="/auth/login" class="btn">Login</a>
          <a href="/auth/register" class="btn btn-primary">Register</a>
        <% } %>
      </div>
    </nav>
  </header>
  <main class="container">
