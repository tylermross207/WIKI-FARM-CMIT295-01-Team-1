<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>WIKI-FARM-CMIT295-01-Team-1</title>
  <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
  <script>
    // Clear unnecessary cookies on page load
    document.addEventListener('DOMContentLoaded', function() {
      const cookieList = document.cookie.split(';');
      const preservedCookies = ['connect.sid']; // Keep session cookie
      
      cookieList.forEach(function(cookie) {
        const cookieName = cookie.split('=')[0].trim();
        if (!preservedCookies.includes(cookieName) && cookieName) {
          document.cookie = cookieName + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        }
      });
    });

    (function() {
      const THEMES = {
        burgundy: { primary: '#5b0b0b', secondary: '#8b3a3a', accent: '#d4af37', border: '#c41e3a', text: '#2c2c2c', 'text-muted': '#666666', bg: '#fbf2e6' },
        ocean: { primary: '#0066cc', secondary: '#003d99', accent: '#ffcc00', border: '#0052a3', text: '#0c3c66', 'text-muted': '#4d7a99', bg: '#e6f2ff' },
        forest: { primary: '#1b5e20', secondary: '#2e7d32', accent: '#ffc107', border: '#1b5e20', text: '#1b5e20', 'text-muted': '#558b2f', bg: '#e8f5e9' },
        sunset: { primary: '#e65100', secondary: '#ff6f00', accent: '#ffc107', border: '#d84315', text: '#bf360c', 'text-muted': '#ff7043', bg: '#fff3e0' },
        purple: { primary: '#6a1b9a', secondary: '#8e24aa', accent: '#00e676', border: '#4a148c', text: '#4a148c', 'text-muted': '#8e24aa', bg: '#f3e5f5' },
        slate: { primary: '#37474f', secondary: '#455a64', accent: '#80deea', border: '#263238', text: '#263238', 'text-muted': '#607d8b', bg: '#eceff1' }
      };
      const savedTheme = localStorage.getItem('wiki-farm-theme') || 'burgundy';
      const theme = THEMES[savedTheme] || THEMES.burgundy;
      const root = document.documentElement;
      root.style.setProperty('--primary', theme.primary);
      root.style.setProperty('--secondary', theme.secondary);
      root.style.setProperty('--accent', theme.accent);
      root.style.setProperty('--border', theme.border);
      root.style.setProperty('--text', theme.text);
      root.style.setProperty('--text-muted', theme['text-muted']);
      root.style.setProperty('--bg', theme.bg);
      if (localStorage.getItem('wiki-farm-dark-mode') === 'true') {
        document.documentElement.classList.add('dark-mode');
      }
    })();
  </script>
</head>
<body>
  <header class="main-header">
    <nav class="container">
      <a href="/" class="logo">WIKI-FARM-CMIT295-01-Team-1</a>
      <div class="nav-links">
        <a href="/" class="nav-item">Home</a>
        <a href="/about" class="nav-item">About</a>
        <a href="/contact" class="nav-item">Contact</a>
        
        <% if (typeof user !== 'undefined' && user) { %>
          <% if (user.is_admin) { %>
            <a href="/admin">Admin</a>
          <% } %>
        <% } %>
        
        <!-- Theme Selector (Disabled feature) -->
        <!-- <select id="theme-selector" class="theme-selector" onchange="applyTheme(this.value)">
          <option value="burgundy">Burgundy</option>
          <option value="ocean">Ocean</option>
          <option value="forest">Forest</option>
          <option value="sunset">Sunset</option>
          <option value="purple">Purple</option>
          <option value="slate">Slate</option>
        </select> -->
        <script>
          const savedTheme = localStorage.getItem('wiki-farm-theme') || 'burgundy';
          const selector = document.getElementById('theme-selector');
          if (selector) {
            selector.value = savedTheme;
          }
        </script>
        
        <!-- Dark Mode Toggle -->
        <button id="dark-mode-btn" class="dark-mode-btn" onclick="toggleDarkMode()" title="Toggle Dark Mode">
          🌙
        </button>
        
        <% if (typeof user !== 'undefined' && user) { %>
          <span class="user-info">
            👤 <%= user.username %>
            <a href="/auth/logout" class="btn btn-sm">Logout</a>
          </span>
        <% } else { %>
          <a href="/auth/login" class="btn btn-primary">Login</a>
          <a href="/auth/register" class="btn btn-primary">Register</a>
          <a href="/w/create" class="btn btn-primary">+ Create Wiki</a>
        <% } %>
      </div>
    </nav>
  </header>
  <main class="container">
